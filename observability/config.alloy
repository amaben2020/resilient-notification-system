// Grafana Alloy config for the EC2 instance running the Express app.
// Fill the two placeholders from Grafana Cloud -> your stack -> Prometheus -> "Send metrics".
// The API key is read from the environment (populate it from SSM at boot):
//   export GRAFANA_CLOUD_API_KEY=$(aws ssm get-parameter --with-decryption \
//     --name /notif-system-staging/grafana-cloud-api-key --query Parameter.Value --output text)

prometheus.scrape "notif_api" {
  targets    = [{ __address__ = "localhost:3300" }]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-XX-prod-us-west-0.grafana.net/api/prom/push" // <- replace XX

    basic_auth {
      username = "REPLACE_WITH_INSTANCE_ID" // numeric Prometheus instance ID
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
