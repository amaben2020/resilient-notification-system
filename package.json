{
  "name": "notif-system",
  "version": "1.0.0",
  "description": "Payment -> SNS fan-out -> SQS -> Lambda workers",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:studio": "node --env-file=.env ./node_modules/.bin/drizzle-kit studio",
    "build:workers": "node scripts/build-workers.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/config/migrate.js",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1135.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2"
  }
}
